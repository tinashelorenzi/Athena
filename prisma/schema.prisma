// Athena — Prisma schema
// Prisma 7: the new `prisma-client` generator emits an ES-module client into a
// path you own (here: src/generated/prisma). Import it via `@/generated/prisma`.
// Docs bundled locally under node_modules/prisma; see also https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string for CLI/Migrate
// lives in prisma.config.ts; the runtime client gets it via a driver adapter
// (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// A console user. Accounts are provisioned — there is no public sign-up.
/// SUPER_ADMIN (instructor) accounts are created with the `create:superadmin`
/// CLI script; STUDENT accounts are created from the instructor portal.
/// `passwordHash` holds an Argon2id PHC string produced by src/lib/password.ts.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// Set for bulk-created accounts (email-derived password): forces a name (+
  /// optional new password) setup on first login before entering the app.
  mustSetName  Boolean   @default(false)
  /// Linked Zaio LMS Mongo user id when the account signs in via SSO.
  zaioUserId     String?   @unique
  /// Zaio LMS student number (institutional ID), synced on SSO login.
  studentNumber  String?   @unique
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  assignments  Assignment[]
  /// Architect is an elevated attribute on an instructor (SUPER_ADMIN): only
  /// architects may author Dojo/Assessment scenarios. Granted via the
  /// `promote:architect` CLI script.
  isArchitect  Boolean   @default(false)
  /// Students belong to a cohort (a bootcamp class/group).
  cohortId     String?
  cohort       Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  progress     ScenarioProgress[]
  runs         ScenarioRun[]
  guideSolves  GuidePromptSolve[]
  flagSolves   FlagSolve[]
  alertCases   AlertCase[]
  machines     Machine[]
  machineEnrollCodes MachineEnrollCode[]
  labParams    LabParam[]
  labSessions  LabSession[]

  @@index([cohortId])
  @@map("users")
}

/// A bootcamp cohort — a group of students. Scenarios are released to a whole
/// cohort by binding them (CohortScenario).
model Cohort {
  id             String           @id @default(cuid())
  name           String           @unique
  /// Linked Zaio bootcamp Mongo `_id` when provisioned from Zaio LMS.
  zaioBootcampId String?          @unique
  createdById    String
  createdAt      DateTime         @default(now())
  students    User[]
  scenarios   CohortScenario[]
  invitations Invitation[]

  @@map("cohorts")
}

/// Binds a scenario to a cohort — releasing it (including hidden dojos) to that
/// cohort's students.
model CohortScenario {
  id         String    @id @default(cuid())
  cohortId   String
  cohort     Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  boundById  String
  releasedAt DateTime  @default(now())
  dueAt      DateTime?

  @@unique([cohortId, scenarioId])
  @@index([cohortId])
  @@index([scenarioId])
  @@map("cohort_scenarios")
}

/// A pending bulk-invitation for a student. The email carries a tokened link to
/// set a name + password; only the token hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  cohortId    String?
  cohort      Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invitations")
}

/// A student's submitted deliverables for a scenario, graded by an instructor.
model Submission {
  id          String           @id @default(cuid())
  scenarioId  String
  scenario    Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  report      String?          @db.Text
  /// An uploaded report (docx/pdf) as an alternative to the typed `report`.
  reportFileKey  String?
  reportFileName String?
  reportFileType String?
  reportFileSize Int?
  flagAnswers Json? // { flagId: answer }
  status      SubmissionStatus @default(SUBMITTED)
  grade       Int?
  feedback    String?          @db.Text
  gradedById  String?
  gradedAt    DateTime?
  /// Set when the instructor releases the committed grade to the student. The
  /// grade/feedback stay hidden from the student until this is non-null.
  releasedAt  DateTime?
  /// Set when an instructor commits the submission for grading — it locks the
  /// submission so the student can no longer re-submit/change it. Until then a
  /// student may re-do an assessment freely.
  committedAt   DateTime?
  committedById String?
  /// LAB scenarios: the ended lab session this submission came from (its
  /// final check run is the auto-grade). Null for SOC scenarios.
  labSessionId  String?          @unique
  labSession    LabSession?      @relation(fields: [labSessionId], references: [id], onDelete: SetNull)
  submittedAt DateTime         @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("submissions")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

/// A SOC scenario (from src/lib/data.js, e.g. "SC-07") assigned to a student by
/// an instructor. `scenarioId` references the catalog id rather than a DB row,
/// since scenarios are static content for now.
model Assignment {
  id           String           @id @default(cuid())
  scenarioId   String
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedById String
  status       AssignmentStatus @default(ASSIGNED)
  dueAt        DateTime?
  createdAt    DateTime         @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("assignments")
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

/// Platform-wide configuration as a namespaced key/value store (e.g.
/// "security.turnstile.siteKey", "mail.smtp.host"). Secret values are stored
/// encrypted (see src/lib/crypto.ts) and never returned raw to the client.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// An authored SOC scenario — a Dojo (teaching, used in lessons) or an
/// Assessment (graded, counts toward reputation). The optional Json sections
/// (logs, alerts, objectives, flags) plus per-endpoint EDR/OSQuery/artifacts
/// define what the student sees as raw SOC data. See docs/scenario-schemas.md.
model Scenario {
  id             String             @id @default(cuid())
  /// SOC (SIEM-style Dojo/Assessment) or LAB (graded on the student's own
  /// machines, docs/labs/spec.md). `type` keeps its Dojo/Assessment meaning for both.
  kind           ScenarioKind       @default(SOC)
  type           ScenarioType
  title          String
  description    String             @default("")
  /// Opaque token for the shareable reference link (`/s/<refToken>`) that can be
  /// embedded in the LMS. Generated on create.
  refToken       String?            @unique
  exposure       Exposure           @default(ROLLOUT)
  /// Dojo-only: when true the scenario is reachable by direct link but hidden
  /// from student listings.
  hidden         Boolean            @default(false)
  /// Real-time simulation: the feed runs continuously and CANNOT be paused (like
  /// a live SOC shift). When false, a Dojo may be paused/resumed.
  realtime       Boolean            @default(false)
  brief          String             @default("") @db.Text // markdown
  objectives     Json? // [{ id, text }]
  flags          Json? // [{ id, question, answer, points }] — answers are server-only
  reportRequired Boolean            @default(false)
  reportPrompt   String?            @db.Text
  logs           Json? // { version, entries: [...] }
  alerts         Json? // { version, alerts: [{ seek, ... }] }
  /// Teaching guide (from an uploaded folder's main.md). `guide` is the markdown
  /// with ```prompt blocks replaced by `[[prompt:id]]` sentinels; `guidePrompts`
  /// holds the parsed prompts incl. answers (server-only); `guideAssets` lists
  /// the uploaded image/asset relative paths (served from object storage).
  guide          String?            @db.Text
  guidePrompts   Json?
  guideAssets    Json?
  /// MITRE ATT&CK technique IDs the scenario exercises (e.g. "T1059.001",
  /// "T0855"). Enterprise (T1xxx) and ICS (T0xxx) may be mixed; links into /attack.
  techniques     String[]           @default([])
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  endpoints      ScenarioEndpoint[]
  cohorts        CohortScenario[]
  submissions    Submission[]
  progress       ScenarioProgress[]
  runs           ScenarioRun[]
  guideSolves    GuidePromptSolve[]
  flagSolves     FlagSolve[]
  alertCases     AlertCase[]
  lab            Lab?

  @@index([type])
  @@map("scenarios")
}

/// A student's case work on a single alert (CTF-style triage): a verdict, notes,
/// extracted IoCs, and an open/closed status. Persists across sessions.
model AlertCase {
  id         String        @id @default(cuid())
  scenarioId String
  scenario   Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alertId    String // the alert's id within the scenario's alerts bundle
  verdict    AlertVerdict?
  status     CaseStatus    @default(OPEN)
  notes      String?       @db.Text
  iocs       Json? // [{ type, value }]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([scenarioId, studentId, alertId])
  @@index([studentId])
  @@map("alert_cases")
}

enum AlertVerdict {
  TRUE_POSITIVE
  FALSE_POSITIVE
  BENIGN
  ESCALATED
}

enum CaseStatus {
  OPEN
  CLOSED
}

/// A student's solved guide prompt (CTF-style progress within a scenario guide).
model GuidePromptSolve {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  promptId   String
  solvedAt   DateTime @default(now())

  @@unique([scenarioId, studentId, promptId])
  @@index([studentId])
  @@map("guide_prompt_solves")
}

/// A student's correct answer to a Dojo scenario flag, checked individually (not
/// at submission). Assessment flags are graded by an instructor instead.
model FlagSolve {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flagId     String
  solvedAt   DateTime @default(now())

  @@unique([scenarioId, studentId, flagId])
  @@index([studentId])
  @@map("flag_solves")
}

/// A student's live run of a scenario. Holds a server-authoritative clock so the
/// data feed (alerts/logs) fires by elapsed time, survives reloads, and supports
/// pause/resume (dojos only). `accumulatedSeconds` is active time banked before
/// the current running segment; `runningSince` marks the current segment start.
model ScenarioRun {
  id                 String     @id @default(cuid())
  scenarioId         String
  scenario           Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId          String
  student            User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             RunStatus  @default(RUNNING)
  startedAt          DateTime   @default(now())
  runningSince       DateTime?
  accumulatedSeconds Int        @default(0)
  lastTickAt         DateTime?
  updatedAt          DateTime   @updatedAt

  @@unique([scenarioId, studentId])
  @@index([status])
  @@map("scenario_runs")
}

enum RunStatus {
  RUNNING
  PAUSED
  COMPLETED
}

/// Tracks when a student first opened a scenario — used to time alert `seek`
/// reveals and to mark in-progress scenarios.
model ScenarioProgress {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("scenario_progress")
}

/// An endpoint within a scenario that carries EDR / OSQuery data and (optionally)
/// an uploaded evidence artifact (a zip stored in object storage).
model ScenarioEndpoint {
  id           String   @id @default(cuid())
  scenarioId   String
  scenario     Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  hostname     String
  edr          Json? // { processes, connections, browserHistory, shellHistory }
  osquery      Json? // { tables: { processes: [...], listening_ports: [...], ... } }
  artifactKey  String? // object-storage key for the evidence zip
  artifactName String?
  artifactSize Int?
  createdAt    DateTime @default(now())

  @@unique([scenarioId, hostname])
  @@index([scenarioId])
  @@map("scenario_endpoints")
}

enum ScenarioType {
  DOJO
  ASSESSMENT
}

enum ScenarioKind {
  SOC
  LAB
}

enum Exposure {
  ROLLOUT
  PUBLIC
}

/// An API key for external integrations. Only the SHA-256 hash is stored; the
/// raw key (prefixed `ath_`) is shown once at creation. `prefix` is the public,
/// non-secret leading segment used to identify the key in listings.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String    @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([prefix])
  @@map("api_keys")
}

/// An authenticated login session. The browser holds an opaque random token;
/// only its SHA-256 hash is stored here, so a database leak can't be replayed
/// as a valid cookie. Sessions are revocable (deleted on logout / expiry).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum Role {
  SUPER_ADMIN
  STUDENT
}

// ── Labs: student machines (docs/labs/spec.md) ───────────────────────────────

/// A student-owned VM enrolled with the `zaio` agent. A user may have several.
/// The agent proves it is this machine by signing every request with the
/// private half of `publicKey` (spec 7.2).
model Machine {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  /// Hostname Athena assigned at enrolment: zaio-<handle>-<NN>.
  hostname       String
  /// Ed25519 public key, base64 of the raw 32 bytes.
  publicKey      String
  /// `SHA256:` + unpadded base64 of sha256(raw key).
  keyFingerprint String
  /// /etc/machine-id and DMI product_uuid — used to spot one VM enrolled by two students.
  machineId      String
  productUuid    String?
  os             String
  osVersion      String
  osPretty       String        @default("")
  arch           String
  agentVersion   String
  capabilities   String[]      @default([])
  /// Instructor-facing signals raised on this machine, e.g. MACHINE_SHARED.
  flags          String[]      @default([])
  status         MachineStatus @default(ACTIVE)
  enrolledAt     DateTime      @default(now())
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  lastSeenIp     String?
  sessionRoles   LabSessionMachine[]
  tasks          AgentTask[]

  @@index([userId])
  @@index([machineId])
  @@map("machines")
}

enum MachineStatus {
  ACTIVE
  REVOKED
}

/// One-time enrolment code (10 minutes, single use). Only sha256(code) is stored.
model MachineEnrollCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("machine_enroll_codes")
}

/// Replay cache for signed agent requests: (machine, ts, signature) seen in the
/// last 10 minutes. Kept in Postgres so it survives restarts.
model AgentRequestNonce {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_request_nonces")
}

/// Append-only audit log for labs: enrolments, revocations, rejected requests,
/// flags, overrides. Also backs enrolment rate limiting (ENROL_FAILED rows).
model LabAuditEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  machineId String?
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("lab_audit_events")
}

// ── Labs: definitions and per-student parameters ─────────────────────────────

/// The lab behind a LAB scenario. `slug` is what students type (`zaio start p21-web`)
/// and what the Autobuilder matches on re-upload.
model Lab {
  id         String       @id @default(cuid())
  scenarioId String       @unique
  scenario   Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  slug       String       @unique
  createdAt  DateTime     @default(now())
  versions   LabVersion[]
  params     LabParam[]

  @@map("labs")
}

/// One immutable upload of a lab. Sessions pin to a version, so re-uploading
/// never changes how a running session is graded.
model LabVersion {
  id          String   @id @default(cuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  version     Int
  /// Lab-language version the definition was written in.
  zcl         Int
  /// Compiled lab.yaml (src/lib/labs/language/types.ts CompiledLab).
  definition  Json
  /// [{ name, file, sha256, size, storageKey }]
  assets      Json
  /// The reference-evidence gate result recorded at upload.
  gate        Json
  /// The lab.yaml text this version was compiled from (for the check editor).
  source      String?  @db.Text
  /// Reference evidence from the upload: { good?, broken?, brokenExpect? }
  /// (lab/reference/*.json), so the check editor and re-publishing can re-run the gate.
  references  Json?
  createdById String
  createdAt   DateTime @default(now())
  sessions    LabSession[]

  @@unique([labId, version])
  @@map("lab_versions")
}

/// A student's parameter values for a lab, generated on first view and kept,
/// so they never change mid-lab and copy detection is a lookup.
model LabParam {
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  values    Json
  createdAt DateTime @default(now())

  @@id([labId, userId])
  @@index([labId])
  @@map("lab_params")
}

// ── Labs: sessions, check runs and the agent task queue (spec section 8) ─────

/// One bracketed attempt at a lab: baseline at start, work, checks, final grade.
/// Pinned to the LabVersion it started on.
model LabSession {
  id           String              @id @default(cuid())
  labVersionId String
  labVersion   LabVersion          @relation(fields: [labVersionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       LabSessionStatus    @default(PREPARING)
  /// Random per session; available to labs as {{session.nonce}}.
  nonce        String
  createdAt    DateTime            @default(now())
  /// Set when every machine's baseline is in (status → ACTIVE).
  startedAt    DateTime?
  /// Time limit or lab close, whichever is first. Null = no limit.
  deadlineAt   DateTime?
  endedAt      DateTime?
  /// Final grade (from the final check run).
  score        Int?
  maxScore     Int?
  flags        String[]            @default([])
  /// Instructor override of the final score (out of maxScore), with a reason.
  /// The effective score is overrideScore ?? score.
  overrideScore  Int?
  overrideReason String?
  overrideById   String?
  overrideAt     DateTime?
  /// Why a session was aborted/expired, shown to the student.
  note         String?
  machines     LabSessionMachine[]
  checkRuns    LabCheckRun[]
  tasks        AgentTask[]
  submission   Submission?

  @@index([userId, status])
  @@index([labVersionId])
  @@map("lab_sessions")
}

enum LabSessionStatus {
  PREPARING
  ACTIVE
  ENDING
  ENDED
  EXPIRED
  ABORTED
}

/// A machine filling one of the lab's roles in a session, with its baseline.
model LabSessionMachine {
  sessionId String
  session   LabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  machineId String
  machine   Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  /// { files: {path: sha256}, logs: {path: {size, inode}}, bootId, takenAt }
  baseline  Json?

  @@id([sessionId, role])
  @@index([machineId])
  @@map("lab_session_machines")
}

/// One evaluation inside a session: practice checks, or the final one at end.
model LabCheckRun {
  id          String         @id @default(cuid())
  sessionId   String
  session     LabSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  final       Boolean        @default(false)
  status      CheckRunStatus @default(COLLECTING)
  requestedAt DateTime       @default(now())
  completedAt DateTime?
  /// Evidence per role (protocol/schema/evidence.schema.json roles), size-capped.
  evidence    Json?
  /// GradeResult (src/lib/labs/language/grade.ts) minus parsed values.
  result      Json?
  score       Int?
  maxScore    Int?
  graderRev   String?
  /// Set when an instructor re-graded this run (the audit log keeps the old result).
  regradedAt  DateTime?
  /// LabVersion whose checks produced `result` (differs from the session's when re-graded against a newer version).
  gradedWithVersionId String?
  tasks       AgentTask[]

  @@index([sessionId, requestedAt])
  @@map("lab_check_runs")
}

enum CheckRunStatus {
  COLLECTING
  GRADED
  FAILED
}

/// Work queued for one machine's agent, carrying a signed bundle.
model AgentTask {
  id          String          @id @default(cuid())
  machineId   String
  machine     Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     LabSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkRunId  String?
  checkRun    LabCheckRun?    @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
  role        String?
  kind        AgentTaskKind
  /// The exact bytes that were signed (UTF-8 JSON).
  bundle      Bytes
  signature   String
  keyId       String
  status      AgentTaskStatus @default(QUEUED)
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
  deliveredAt DateTime?
  completedAt DateTime?
  /// Agent-reported failure, if any.
  error       String?

  @@index([machineId, status])
  @@index([sessionId])
  @@map("agent_tasks")
}

enum AgentTaskKind {
  BASELINE
  COLLECT
  UNDO
}

enum AgentTaskStatus {
  QUEUED
  DELIVERED
  DONE
  FAILED
  EXPIRED
}
