// Athena — Prisma schema
// Prisma 7: the new `prisma-client` generator emits an ES-module client into a
// path you own (here: src/generated/prisma). Import it via `@/generated/prisma`.
// Docs bundled locally under node_modules/prisma; see also https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string for CLI/Migrate
// lives in prisma.config.ts; the runtime client gets it via a driver adapter
// (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// A console user. Accounts are provisioned — there is no public sign-up.
/// SUPER_ADMIN (instructor) accounts are created with the `create:superadmin`
/// CLI script; STUDENT accounts are created from the instructor portal.
/// `passwordHash` holds an Argon2id PHC string produced by src/lib/password.ts.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  assignments  Assignment[]
  /// Architect is an elevated attribute on an instructor (SUPER_ADMIN): only
  /// architects may author Dojo/Assessment scenarios. Granted via the
  /// `promote:architect` CLI script.
  isArchitect  Boolean   @default(false)
  /// Students belong to a cohort (a bootcamp class/group).
  cohortId     String?
  cohort       Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  progress     ScenarioProgress[]
  runs         ScenarioRun[]
  guideSolves  GuidePromptSolve[]

  @@index([cohortId])
  @@map("users")
}

/// A bootcamp cohort — a group of students. Scenarios are released to a whole
/// cohort by binding them (CohortScenario).
model Cohort {
  id          String           @id @default(cuid())
  name        String           @unique
  createdById String
  createdAt   DateTime         @default(now())
  students    User[]
  scenarios   CohortScenario[]
  invitations Invitation[]

  @@map("cohorts")
}

/// Binds a scenario to a cohort — releasing it (including hidden dojos) to that
/// cohort's students.
model CohortScenario {
  id         String    @id @default(cuid())
  cohortId   String
  cohort     Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  boundById  String
  releasedAt DateTime  @default(now())
  dueAt      DateTime?

  @@unique([cohortId, scenarioId])
  @@index([cohortId])
  @@index([scenarioId])
  @@map("cohort_scenarios")
}

/// A pending bulk-invitation for a student. The email carries a tokened link to
/// set a name + password; only the token hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  cohortId    String?
  cohort      Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invitations")
}

/// A student's submitted deliverables for a scenario, graded by an instructor.
model Submission {
  id          String           @id @default(cuid())
  scenarioId  String
  scenario    Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  report      String?          @db.Text
  flagAnswers Json? // { flagId: answer }
  status      SubmissionStatus @default(SUBMITTED)
  grade       Int?
  feedback    String?          @db.Text
  gradedById  String?
  gradedAt    DateTime?
  submittedAt DateTime         @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("submissions")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

/// A SOC scenario (from src/lib/data.js, e.g. "SC-07") assigned to a student by
/// an instructor. `scenarioId` references the catalog id rather than a DB row,
/// since scenarios are static content for now.
model Assignment {
  id           String           @id @default(cuid())
  scenarioId   String
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedById String
  status       AssignmentStatus @default(ASSIGNED)
  dueAt        DateTime?
  createdAt    DateTime         @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("assignments")
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

/// Platform-wide configuration as a namespaced key/value store (e.g.
/// "security.turnstile.siteKey", "mail.smtp.host"). Secret values are stored
/// encrypted (see src/lib/crypto.ts) and never returned raw to the client.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// An authored SOC scenario — a Dojo (teaching, used in lessons) or an
/// Assessment (graded, counts toward reputation). The optional Json sections
/// (logs, alerts, objectives, flags) plus per-endpoint EDR/OSQuery/artifacts
/// define what the student sees as raw SOC data. See docs/scenario-schemas.md.
model Scenario {
  id             String             @id @default(cuid())
  type           ScenarioType
  title          String
  description    String             @default("")
  /// Opaque token for the shareable reference link (`/s/<refToken>`) that can be
  /// embedded in the LMS. Generated on create.
  refToken       String?            @unique
  exposure       Exposure           @default(ROLLOUT)
  /// Dojo-only: when true the scenario is reachable by direct link but hidden
  /// from student listings.
  hidden         Boolean            @default(false)
  brief          String             @default("") @db.Text // markdown
  objectives     Json? // [{ id, text }]
  flags          Json? // [{ id, question, answer, points }] — answers are server-only
  reportRequired Boolean            @default(false)
  reportPrompt   String?            @db.Text
  logs           Json? // { version, entries: [...] }
  alerts         Json? // { version, alerts: [{ seek, ... }] }
  /// Teaching guide (from an uploaded folder's main.md). `guide` is the markdown
  /// with ```prompt blocks replaced by `[[prompt:id]]` sentinels; `guidePrompts`
  /// holds the parsed prompts incl. answers (server-only); `guideAssets` lists
  /// the uploaded image/asset relative paths (served from object storage).
  guide          String?            @db.Text
  guidePrompts   Json?
  guideAssets    Json?
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  endpoints      ScenarioEndpoint[]
  cohorts        CohortScenario[]
  submissions    Submission[]
  progress       ScenarioProgress[]
  runs           ScenarioRun[]
  guideSolves    GuidePromptSolve[]

  @@index([type])
  @@map("scenarios")
}

/// A student's solved guide prompt (CTF-style progress within a scenario guide).
model GuidePromptSolve {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  promptId   String
  solvedAt   DateTime @default(now())

  @@unique([scenarioId, studentId, promptId])
  @@index([studentId])
  @@map("guide_prompt_solves")
}

/// A student's live run of a scenario. Holds a server-authoritative clock so the
/// data feed (alerts/logs) fires by elapsed time, survives reloads, and supports
/// pause/resume (dojos only). `accumulatedSeconds` is active time banked before
/// the current running segment; `runningSince` marks the current segment start.
model ScenarioRun {
  id                 String     @id @default(cuid())
  scenarioId         String
  scenario           Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId          String
  student            User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             RunStatus  @default(RUNNING)
  startedAt          DateTime   @default(now())
  runningSince       DateTime?
  accumulatedSeconds Int        @default(0)
  feedCursor         Int        @default(0) // seconds up to which events are materialized
  lastTickAt         DateTime?
  updatedAt          DateTime   @updatedAt
  events             RunEvent[]

  @@unique([scenarioId, studentId])
  @@index([status])
  @@map("scenario_runs")
}

/// A materialized feed event (an alert or log line that has "fired") — the
/// stored state produced by the soc-master workers / load-time catch-up.
model RunEvent {
  id        String       @id @default(cuid())
  runId     String
  run       ScenarioRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      RunEventKind
  refId     String
  atSeconds Int
  firedAt   DateTime     @default(now())
  payload   Json

  @@unique([runId, kind, refId])
  @@index([runId])
  @@map("run_events")
}

enum RunStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum RunEventKind {
  ALERT
  LOG
}

/// Tracks when a student first opened a scenario — used to time alert `seek`
/// reveals and to mark in-progress scenarios.
model ScenarioProgress {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())

  @@unique([scenarioId, studentId])
  @@index([studentId])
  @@map("scenario_progress")
}

/// An endpoint within a scenario that carries EDR / OSQuery data and (optionally)
/// an uploaded evidence artifact (a zip stored in object storage).
model ScenarioEndpoint {
  id           String   @id @default(cuid())
  scenarioId   String
  scenario     Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  hostname     String
  edr          Json? // { processes, connections, browserHistory, shellHistory }
  osquery      Json? // { tables: { processes: [...], listening_ports: [...], ... } }
  artifactKey  String? // object-storage key for the evidence zip
  artifactName String?
  artifactSize Int?
  createdAt    DateTime @default(now())

  @@unique([scenarioId, hostname])
  @@index([scenarioId])
  @@map("scenario_endpoints")
}

enum ScenarioType {
  DOJO
  ASSESSMENT
}

enum Exposure {
  ROLLOUT
  PUBLIC
}

/// An API key for external integrations. Only the SHA-256 hash is stored; the
/// raw key (prefixed `ath_`) is shown once at creation. `prefix` is the public,
/// non-secret leading segment used to identify the key in listings.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String    @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([prefix])
  @@map("api_keys")
}

/// An authenticated login session. The browser holds an opaque random token;
/// only its SHA-256 hash is stored here, so a database leak can't be replayed
/// as a valid cookie. Sessions are revocable (deleted on logout / expiry).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum Role {
  SUPER_ADMIN
  STUDENT
}
