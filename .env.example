# Athena — environment template. Copy to `.env` and adjust before running.
#   cp .env.example .env
#
# Consumed by BOTH docker-compose (provisions the postgres container) and the
# Next.js app + Prisma (DATABASE_URL). Keep DATABASE_URL in sync with the
# POSTGRES_* values below.

# ── PostgreSQL container credentials ─────────────────────────────
POSTGRES_USER=athena
POSTGRES_PASSWORD=change_me
POSTGRES_DB=athena
# Host port the container publishes (container always listens on 5432).
POSTGRES_PORT=5432

# ── Prisma / Next.js connection string ───────────────────────────
# Use host `localhost` when Next.js runs on your machine; use `db` (the compose
# service name) if you run Next.js inside docker-compose.
DATABASE_URL="postgresql://athena:change_me@localhost:5432/athena?schema=public"

# ── Secret encryption key ────────────────────────────────────────
# Encrypts platform secrets stored in the DB (AES-256-GCM). 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATHENA_SETTINGS_KEY="generate_me"

# ── MinIO (object storage container) ─────────────────────────────
# Root admin creds + bucket. docker-compose creates the bucket on `up`; then run
# scripts/minio-credentials.sh to mint a scoped key for Settings → Storage.
MINIO_ROOT_USER=athena-admin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=athena-artifacts
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Session cookie ───────────────────────────────────────────────
# Blank = Secure only in production. `false` allows login over plain HTTP
# (HTTP staging); `true` forces Secure.
SESSION_COOKIE_SECURE=
