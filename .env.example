# Athena — environment template. Copy to `.env` and adjust before running.
#   cp .env.example .env
#
# Consumed by BOTH docker-compose (provisions the postgres container) and the
# Next.js app + Prisma (DATABASE_URL). Keep DATABASE_URL in sync with the
# POSTGRES_* values below.

# ── PostgreSQL container credentials ─────────────────────────────
POSTGRES_USER=athena
POSTGRES_PASSWORD=change_me
POSTGRES_DB=athena
# Host port the container publishes (container always listens on 5432).
POSTGRES_PORT=5432

# ── Prisma / Next.js connection string ───────────────────────────
# Use host `localhost` when Next.js runs on your machine; use `db` (the compose
# service name) if you run Next.js inside docker-compose.
DATABASE_URL="postgresql://athena:change_me@localhost:5432/athena?schema=public"

# ── Secret encryption key ────────────────────────────────────────
# Encrypts platform secrets stored in the DB (AES-256-GCM). 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATHENA_SETTINGS_KEY="generate_me"

# ── MinIO (object storage container) ─────────────────────────────
# Root admin creds + bucket. docker-compose creates the bucket on `up`; then run
# scripts/minio-credentials.sh to mint a scoped key for Settings → Storage.
MINIO_ROOT_USER=athena-admin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=athena-artifacts
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Session cookie ───────────────────────────────────────────────
# Blank = Secure only in production. `false` allows login over plain HTTP
# (HTTP staging); `true` forces Secure.
SESSION_COOKIE_SECURE=

# ── Public base URL ──────────────────────────────────────────────
# Absolute URL of the deployment, used to build links in invitation emails
# (e.g. https://athena.zaio.io). Leave blank to derive it from the request
# headers (Host + X-Forwarded-Proto) — but SET IT behind a reverse proxy,
# especially plain-HTTP nginx that doesn't send X-Forwarded-Proto, so emailed
# links use the right scheme/host. No trailing slash.
APP_BASE_URL=

# ── Zaio LMS SSO (Sign in with Zaio) ───────────────────────────
# Shared secret with zaio-backend ATHENA_SSO_CLIENT_SECRET.
ZAIO_SSO_CLIENT_ID=athena
ZAIO_SSO_CLIENT_SECRET=change_me_shared_secret
# Zaio LMS frontend authorize page (local dev: run LMS on another port than Athena).
ZAIO_SSO_AUTHORIZE_URL=http://localhost:3001/athena-authorize
# Zaio backend token exchange endpoint.
ZAIO_SSO_TOKEN_URL=http://localhost:4000/athena-sso/token
# Must match an entry in zaio-backend ATHENA_SSO_REDIRECT_URIS.
ZAIO_SSO_REDIRECT_URI=http://localhost:3000/api/auth/zaio/callback

# ── Zaio Dojo completion webhook ────────────────────────────────
# Athena POSTs here when a student solves all flags in a DOJO scenario.
# Use the same secret as zaio-backend ATHENA_WEBHOOK_SECRET (or SSO secret).
ZAIO_WEBHOOK_URL=http://localhost:4000/bootcamp/athena/dojo-complete
ZAIO_WEBHOOK_SECRET=change_me_shared_secret
